 #include "mm-modem-controller.h"
 
+// Nura: dual-SIM support.  The dialer passes an empty device when it cannot choose one;
+// find the modem that owns the call, or fall back to the first usable modem for dialing.
+static QSharedPointer<ModemManager::ModemDevice> nuraResolveModem(const QString &deviceUni, const QString &callUni, bool forDial)
+{
+    auto modem = ModemManager::findModemDevice(deviceUni);
+    if (!modem.isNull())
+        return modem;
+    const auto devices = ModemManager::modemDevices();
+    if (!forDial) {
+        for (const auto &d : devices) {
+            const auto voice = d->interface(ModemManager::ModemDevice::VoiceInterface).objectCast<ModemManager::ModemVoice>();
+            if (!voice.isNull() && !voice->findCall(callUni).isNull())
+                return d;
+        }
+    }
+    return devices.isEmpty() ? modem : devices.first();
+}
