diff --git a/src/kerneldevice/mm-kernel-device-qrtr.c b/src/kerneldevice/mm-kernel-device-qrtr.c
index 1abfebb..80de3fd 100644
--- a/src/kerneldevice/mm-kernel-device-qrtr.c
+++ b/src/kerneldevice/mm-kernel-device-qrtr.c
@@ -112,6 +112,16 @@ kernel_device_get_name (MMKernelDevice *_self)
 static const gchar *
 kernel_device_get_physdev_uid (MMKernelDevice *_self)
 {
+    MMKernelDeviceQrtr *self = MM_KERNEL_DEVICE_QRTR (_self);
+
+    /* Nura: QRTR node 0 is the real modem; any other node (our DSDS proxy for the
+     * second subscription) is a separate modem, so give it its own device uid. */
+    if (qrtr_node_get_id (self->priv->node) != 0) {
+        if (!self->priv->physdev_uid)
+            self->priv->physdev_uid = g_strdup_printf ("%s-node%u", MM_KERNEL_DEVICE_QRTR_PHYSDEV_UID,
+                                                       qrtr_node_get_id (self->priv->node));
+        return self->priv->physdev_uid;
+    }
     return MM_KERNEL_DEVICE_QRTR_PHYSDEV_UID;
 }
 
